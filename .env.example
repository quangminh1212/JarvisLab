# =============================================
# JarvisLab - Environment Configuration
# =============================================
# Copy this file to .env and adjust as needed

# Python executable path (default: python)
# VOICE_PYTHON=python

# Default language for STT and TTS (BCP-47 format)
VOICE_LANGUAGE=vi-VN

# Microphone device index (-1 = system default)
# Run: npm run test:devices
# VOICE_MIC_INDEX=-1

# TTS voice override (edge-tts voice name)
# VOICE_TTS_VOICE=vi-VN-HoaiMyNeural

# Mic tuning for weak USB mics
# VOICE_GAIN=50
# VOICE_THRESHOLD=0.0025
# VOICE_SILENCE_SEC=0.85
# VOICE_POST_TTS_DELAY=0.45

# Optional LLM (defaults to Hermes xAI OAuth if available)
# JARVIS_API_KEY=
# JARVIS_BASE_URL=https://api.x.ai/v1
# JARVIS_MODEL=grok-4-1-fast-non-reasoning
