{
  "name": "jarvislab",
  "version": "1.2.0",
  "description": "JarvisLab — MCP + standalone voice bridge so AI agents talk with humans via mic/speaker like a real phone call",
  "main": "src/server.js",
  "type": "module",
  "bin": {
    "jarvislab": "bin/mcp-voice-bridge.js"
  },
  "scripts": {
    "start": "node bin/mcp-voice-bridge.js",
    "dev": "node --watch bin/mcp-voice-bridge.js",
    "call": "python jarvis_call.py",
    "test": "python scripts/selftest.py",
    "test:e2e": "python scripts/e2e_conversation.py",
    "test:speak": "python python/speak.py \"Xin chào, tôi là Jarvis\" vi-VN",
    "test:listen": "python python/listen.py vi-VN 15",
    "test:devices": "python python/devices.py",
    "test:llm": "python python/llm.py Xin chào"
  },
  "keywords": [
    "mcp",
    "voice",
    "speech",
    "jarvis",
    "ai-agent",
    "microphone",
    "tts",
    "stt"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^16.4.7"
  }
}
